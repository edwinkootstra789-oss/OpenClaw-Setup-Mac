# AI Video Producer v3.1 - 环境变量配置
# 复制此文件为 .env 并填入你的实际 API 密钥
# ⚠️ 此文件包含敏感信息，请勿提交到 Git

# ============================================
# Fish Audio API - 用于语音合成
# 获取地址: https://fish.audio/
# ============================================
FISH_AUDIO_API_KEY=your-fish-audio-api-key-here
FISH_AUDIO_VOICE_ID=59cb5986671546eaa6ca8ae6f29f6d22

# ============================================
# HeyGen API - 用于视频合成
# 获取地址: https://app.heygen.com/settings/api-keys
# ============================================
HEYGEN_API_KEY=***

# ============================================
# 代理配置（如果需要访问外网API）
# ============================================
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
